    "Cofre" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cofre"
          }
        }
      }
    },
    "Cofre also locks when your Mac sleeps, the screen locks or you quit." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cofre também tranca quando o Mac dorme, a tela é bloqueada ou você sai do app."
          }
        }
      }
    },
    "Cofre couldn't confirm it's you." : {
      "extractionState" : "manual",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cofre não conseguiu confirmar que é você."
          }
        }
      }
    },
    "Cofre is locked" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cofre está trancado"
          }
        }
      }
    },
    "Cofre is locked. Unlock it to use your secrets." : {
      "extractionState" : "manual",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
