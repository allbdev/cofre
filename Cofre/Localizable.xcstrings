{
  "sourceLanguage" : "en",
  "strings" : {
    "↩ copy · ↑↓ choose · esc close" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↩ copiar · ↑↓ escolher · esc fechar"
          }
        }
      }
    },
    "Add" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar"
          }
        }
      }
    },
    "Add an API key, token or password. Its value is never shown, only copied." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma chave de API, um token ou uma senha. O valor nunca aparece, só é copiado."
          }
        }
      }
    },
    "Added: %lld · Replaced: %lld · Skipped: %lld" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionados: %lld · Substituídos: %lld · Ignorados: %lld"
          }
        }
      }
    },
    "At least %lld characters. A few unrelated words work well." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelo menos %lld caracteres. Algumas palavras sem relação entre si funcionam bem."
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
