    "e.g. Stripe secret key (prod)" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ex.: chave secreta do Stripe (prod)"
          }
        }
      }
    },
    "Every secret is encrypted into one file with a passphrase you choose. Keep the file anywhere; without the passphrase it's useless, and nobody can recover a forgotten passphrase." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os segredos são criptografados em um arquivo com uma frase-senha que você escolhe. Guarde o arquivo onde quiser: sem a frase-senha ele é inútil, e ninguém consegue recuperar uma frase-senha esquecida."
          }
        }
      }
    },
    "Export a Backup" : {
      "localizations" : {
        "pt-BR" : {
